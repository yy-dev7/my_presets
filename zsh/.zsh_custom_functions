function gcml() {
  # 检查是否存在 main 分支
  if git show-ref --verify --quiet refs/heads/main; then
    branch="main"
  # 检查是否存在 master 分支
  elif git show-ref --verify --quiet refs/heads/master; then
    branch="master"
  else
    echo "Neither main nor master branch found."
    return 1
  fi
  # 使用 git log 命令比较 branch 与 production 分支的差异,包含提交者名称和日期
  git log --left-right --graph --cherry-mark --no-merges \
    --format="%C(auto)%h%d %C(green)%ad%C(reset) %C(cyan)%an%C(reset) - %s" \
    --date=format:'%Y-%m-%d %H:%M:%S' $branch...production
}

function delete_git_branch() {
    if [ -z "$1" ]; then
        echo "Usage: delete_git_branch <prefix> [remote]"
        echo "prefix: The prefix of branch names to delete."
        echo "remote: Optional. Specify any value (e.g., 'remote') to also delete remote branches."
        return
    fi

    # 删除本地分支
    git branch | grep "^  $1" | while read -r branch; do
        echo "Deleting local branch: $branch"
        git branch -D "${branch// /}"
    done

    # 检查是否也删除远程分支
    if [ -n "$2" ]; then
        git branch -r | grep "/$1" | while read -r branch; do
            remote_branch=${branch#origin/}
            echo "Deleting remote branch: $remote_branch"
            git push origin --delete "$remote_branch"
        done
    fi
}

# 定义开启代理的函数
function proxy_on() {
    export http_proxy="http://127.0.0.1:6152"
    export https_proxy="http://127.0.0.1:6152"
    export HTTP_PROXY="http://127.0.0.1:6152"
    export HTTPS_PROXY="http://127.0.0.1:6152"
    echo "代理已开启"
}

# 定义关闭代理的函数
function proxy_off() {
    unset http_proxy
    unset https_proxy
    unset HTTP_PROXY
    unset HTTPS_PROXY
    echo "代理已关闭"
}

