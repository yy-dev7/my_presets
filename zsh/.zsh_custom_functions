claude_sync() {
  local -a options=(".claude-internal  →  .claude（恢复到官方版）" ".claude  →  .claude-internal（恢复到内部版）")
  local selected=0
  local key i

  tput civis

  echo "请选择同步方向（↑/↓ 选择，Enter 确认，q 退出）："
  for i in {1..${#options[@]}}; do
    [[ $((i - 1)) -eq $selected ]] && echo "  ❯ ${options[$i]}" || echo "    ${options[$i]}"
  done

  while true; do
    IFS= read -r -s -k1 key
    if [[ $key == $'\x1b' ]]; then
      read -r -s -k2 key
      case "$key" in
        '[A') (( selected > 0 )) && (( selected-- )) ;;
        '[B') (( selected < ${#options[@]} - 1 )) && (( selected++ )) ;;
      esac
    elif [[ $key == $'\n' || $key == '' ]]; then
      break
    elif [[ $key == 'q' ]]; then
      tput cnorm
      echo ""
      echo "已退出。"
      return 0
    fi

    tput cuu ${#options[@]}
    tput ed
    for i in {1..${#options[@]}}; do
      [[ $((i - 1)) -eq $selected ]] && echo "  ❯ ${options[$i]}" || echo "    ${options[$i]}"
    done
  done

  tput cnorm
  echo ""

  case $selected in
    0) local src_base=~/.claude-internal; local dst_base=~/.claude ;;
    1) local src_base=~/.claude;          local dst_base=~/.claude-internal ;;
  esac

  echo "已选择：${options[$((selected + 1))]}"
  echo ""

  read "session_id?请输入 Session ID: "

  if [[ -z "$session_id" ]]; then
    echo "错误：Session ID 不能为空。"
    return 1
  fi

  local src
  src=$(find "${src_base}/projects" -name "${session_id}.jsonl" 2>/dev/null)

  if [[ -z "$src" ]]; then
    echo "错误：在 ${src_base}/projects 中未找到 ${session_id}.jsonl"
    return 1
  fi

  local dest="${src/${src_base}/${dst_base}}"
  mkdir -p "$(dirname "$dest")"
  cp "$src" "$dest"
  echo ""
  echo "✅ 同步完成：$dest"
  echo "▶  恢复命令：claude --resume $session_id"
}

